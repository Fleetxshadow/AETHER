# No credentials required for the complete bundled demonstration.
# Real operational geography requires a Google Maps JavaScript API web key.
# Put real values in .env.local; Next.js does not load this example file.
# Restrict this public browser key by website HTTP referrers and Maps JavaScript API.
# Enable that API and billing on your Google project. Rebuild after changing public vars.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional dedicated Firebase web app. Public configuration is not authorization.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_NEXUS_SITE_ID=main
NEXT_PUBLIC_NEXUS_FRESHNESS_MS=60000
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# Optional traffic backend. Demo requires neither Firebase nor paid providers.
NEXUS_TRAFFIC_LIVE_ENABLED=false
# NEXUS_TRAFFIC_SETTINGS={"freshnessMs":90000,"minimumSamples":4,"minimumPersistenceMs":120000,"recoveryMs":180000,"cooldownMs":600000,"expiryMs":900000,"ratios":[0.85,0.65,0.45,0.25]}

# Privileged server camera registry; disabled by default. Never use NEXT_PUBLIC for secrets.
NEXUS_FIREBASE_ADMIN_ENABLED=false
NEXUS_FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/location/nexus-service-account.json
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Exact read-only MediaMTX origins; comma-separated. No wildcard or URL credentials.
# NEXUS_CAMERA_ALLOWED_ORIGINS=https://video.example.com,https://hls.example.com
# NEXUS_MEDIAMTX_BEARER_TOKEN=server-only-approved-reader-token
NEXUS_CAMERA_ALLOW_LOCAL_HTTP=false

# Optional RESPONSE local operator and signed demo-webhook credentials (server-only).
# Run node scripts/response-setup.mjs to generate .env.local without printing secrets.
# NEXUS_OPERATOR_PASSWORD=replace-with-a-long-random-secret
# NEXUS_DEMO_WEBHOOK_SECRET=replace-with-a-separate-random-secret
# No live telephony or outbound calling is configured or implemented.
# Optional, public raster tile URL. Must include {z}/{x}/{y}; use an appropriately licensed provider.
# NEXT_PUBLIC_MAP_TILE_URL=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors © CARTO
