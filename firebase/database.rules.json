{
  "rules": {
    ".read": false,
    ".write": false,
    "nexus": {
      "$site": {
        "devices": {
          ".read": "auth != null && auth.token.nexusSite === $site && (auth.token.nexusRole === 'viewer' || auth.token.nexusRole === 'operator') && query.limitToLast != null && query.limitToLast <= 200",
          "$device": {
            ".write": "auth != null && auth.token.nexusSite === $site && auth.token.nexusRole === 'device' && auth.token.deviceId === $device",
            ".validate": "newData.hasChildren(['id','name','module','status','lastSeen','source']) && newData.child('id').val() === $device",
            "id": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "module": {
              ".validate": "newData.isString() && newData.val().matches(/^(sky|flow|rescue|thermal|aqua|road|fire|twin|core|command)$/)"
            },
            "status": {
              ".validate": "newData.val() === 'online' || newData.val() === 'offline'"
            },
            "lastSeen": {
              ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
            },
            "source": {
              ".validate": "newData.val() === 'LIVE'"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "telemetry": {
          ".read": "auth != null && auth.token.nexusSite === $site && (auth.token.nexusRole === 'viewer' || auth.token.nexusRole === 'operator') && query.limitToLast != null && query.limitToLast <= 200",
          "$device": {
            "latest": {
              "$channel": {
                ".write": "auth != null && auth.token.nexusSite === $site && auth.token.nexusRole === 'device' && auth.token.deviceId === $device",
                ".validate": "newData.hasChildren(['deviceId','module','channel','value','unit','observedAt','source']) && newData.child('deviceId').val() === $device && newData.child('channel').val() === $channel",
                "deviceId": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
                },
                "module": {
                  ".validate": "newData.isString() && newData.val().matches(/^(sky|flow|rescue|thermal|aqua|road|fire|twin|core|command)$/)"
                },
                "channel": {
                  ".validate": "newData.val().matches(/^(temperature|speed|rainfall|water|health|altitude|battery)$/)"
                },
                "value": {
                  ".validate": "newData.isNumber() && ((($channel === 'health' || $channel === 'battery') && newData.val() >= 0 && newData.val() <= 100) || ($channel === 'temperature' && newData.val() >= -100 && newData.val() <= 2000) || ($channel === 'speed' && newData.val() >= 0 && newData.val() <= 350) || ($channel === 'rainfall' && newData.val() >= 0 && newData.val() <= 5000) || ($channel === 'water' && newData.val() >= 0 && newData.val() <= 100000) || ($channel === 'altitude' && newData.val() >= 0 && newData.val() <= 50000))"
                },
                "unit": {
                  ".validate": "(($channel === 'health' || $channel === 'battery') && newData.val() === '%') || ($channel === 'temperature' && newData.val() === '°C') || ($channel === 'speed' && newData.val() === 'km/h') || ($channel === 'rainfall' && newData.val() === 'mm') || ($channel === 'water' && newData.val() === 'cm') || ($channel === 'altitude' && newData.val() === 'm')"
                },
                "observedAt": {
                  ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
                },
                "source": {
                  ".validate": "newData.val() === 'LIVE'"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "cameraStatus": {
          ".read": "auth != null && auth.token.nexusSite === $site && (auth.token.nexusRole === 'viewer' || auth.token.nexusRole === 'operator') && query.limitToLast != null && query.limitToLast <= 200",
          "$camera": {
            ".write": "auth != null && auth.token.nexusSite === $site && auth.token.nexusRole === 'device' && newData.child('deviceId').val() === auth.token.deviceId && (!data.exists() || data.child('deviceId').val() === auth.token.deviceId)",
            ".validate": "newData.hasChildren(['cameraId','deviceId','online','lastSeen','streamType','source']) && newData.child('cameraId').val() === $camera",
            "cameraId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "deviceId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$/)"
            },
            "streamType": {
              ".validate": "newData.val() === 'vdo-ninja' || newData.val() === 'mediamtx'"
            },
            "source": {
              ".validate": "newData.val() === 'LIVE'"
            },
            "resolution": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2,5}x[0-9]{2,5}$/)"
            },
            "fps": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 240"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
